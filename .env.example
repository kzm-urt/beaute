# ── Anthropic ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# 管理アナリティクスのAPI費用見積もり。未設定時も同じ初期値で計算
ANTHROPIC_INPUT_USD_PER_MTOK=5
ANTHROPIC_OUTPUT_USD_PER_MTOK=25
API_COST_USD_JPY_RATE=155

# ── Supabase ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ──────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Stripeで作成したサブスクのPrice ID
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ── App ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
# カンマ区切り。指定メールは常にPRO扱い
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Rakuten Web Service ─────────────────────
RAKUTEN_APPLICATION_ID=your_rakuten_application_id
RAKUTEN_ACCESS_KEY=your_rakuten_access_key
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=your_rakuten_affiliate_id
# 楽天アプリ設定で許可した本番URL。未設定時は https://beaute.vercel.app を使用
RAKUTEN_REQUEST_ORIGIN=https://beaute.vercel.app
# 美容・コスメ・香水の通常料率4%、1商品1個あたり報酬上限1000円
RAKUTEN_AFFILIATE_RATE=0.04
RAKUTEN_AFFILIATE_REWARD_CAP_JPY=1000
